---
layout: null
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.title | xml_escape }}</title>
  <subtitle>{{ site.description | xml_escape }}</subtitle>
  <link href="{{ site.url }}/atom.xml" rel="self" type="application/atom+xml"/>
  <link href="{{ site.url }}/"/>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <id>{{ site.url }}/</id>
  <author><name>{{ site.author.name }}</name></author>
  {% assign pages = site.pages | where_exp: "p", "p.title" | sort: "path" %}
  {% for p in pages %}
  <entry>
    <title>{{ p.title | xml_escape }}</title>
    <link href="{{ site.url }}{{ p.url | replace: '.html', '' }}/"/>
    <id>{{ site.url }}{{ p.url }}</id>
    <updated>{{ site.time | date_to_xmlschema }}</updated>
    <summary>{{ p.description | default: p.excerpt | default: p.title | strip_html | xml_escape }}</summary>
  </entry>
  {% endfor %}
</feed>
